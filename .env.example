# Copy to .env for local work. On Render, set these in the dashboard. Never commit real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-string
STORAGE_DIR=instance/uploads
PROXY_HOPS=0            # set to 1 behind Render's proxy so rate limits use each visitor's real IP
HUB_CEO_EMAIL=          # only read by seed.py
HUB_CEO_PASSWORD=       # only read by seed.py
MAIL_BACKEND=console    # console logs only; smtp sends for real
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=              # e.g. Work Hub <hub@yourdomain.com>
APP_URL=                # e.g. https://work-hub.onrender.com, used for the links in emails
